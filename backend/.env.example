# NexaChain AI — Backend Environment Configuration Template
# Copy this file to .env and configure values for your environment.
# In production/staging, never commit real secrets to source control.

PORT=5000
NODE_ENV=development

# MongoDB URI (Atlas Replica Set for production, local for development)
# Production Atlas format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/nexachain?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/nexachain

# Cryptographic JWT Secret (Minimum 32 characters in production)
# In production, generate using: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_SECURE_JWT_SECRET_MIN_32_CHARACTERS

# JWT Expiration Duration
JWT_EXPIRES_IN=24h

# ROI Scheduler Configuration (node-cron expression and IANA timezone)
CRON_SCHEDULE=0 0 * * *
CRON_TIMEZONE=Asia/Kolkata

# Allowed Frontend Origins for CORS (comma-separated if multiple)
# In production, set to your Vercel frontend URL, e.g. https://nexa-ai-nine-ecru.vercel.app
CLIENT_URL=http://localhost:5173

# Administrative Secret Key for Manual ROI Processing / Admin Routes
# In production, generate using: openssl rand -hex 24
ADMIN_SECRET_KEY=REPLACE_WITH_SECURE_ADMIN_SECRET_KEY
