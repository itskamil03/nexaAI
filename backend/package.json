{
  "name": "nexachain-backend",
  "version": "1.0.0",
  "description": "NexaChain AI Investment and Referral Platform Backend API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --runInBand --detectOpenHandles --forceExit",
    "test:staging": "node scripts/run_staging_smoke_tests.js",
    "verify:transactions": "node scripts/verify_transactions.js",
    "verify:e2e": "node scripts/verify_e2e.js"
  },
  "keywords": [
    "nexachain",
    "mern",
    "investment",
    "referral",
    "roi",
    "node-cron"
  ],
  "author": "NexaChain Engineering",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.10.1",
    "morgan": "^1.10.0",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000,
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ]
  }
}
