# NexaChain AI — Staging Backend Environment Template
# NEVER commit real credentials to source control.
# Copy this file to .env on the staging server and inject secure values.

PORT=5000
NODE_ENV=staging

# MongoDB Replica Set URI (Required for Multi-Document ACID Transactions)
# Example: mongodb://staging_user:StagingPassword2026!@mongo1.internal:27017,mongo2.internal:27017,mongo3.internal:27017/nexachain_staging?replicaSet=rs0&authSource=admin&ssl=false
MONGODB_URI=mongodb://127.0.0.1:27017/nexachain_staging

# High-Entropy JWT Secret (Minimum 64 random characters)
# Generate with: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_SECURE_64_CHAR_HEX_SECRET_FOR_STAGING_ENVIRONMENT

# Token Expiration (Recommended 12h-24h for staging QA)
JWT_EXPIRES_IN=24h

# Scheduler Configuration (12:00 AM daily in Asia/Kolkata)
CRON_SCHEDULE=0 0 * * *
CRON_TIMEZONE=Asia/Kolkata

# Staging Frontend URL (for Strict CORS Whitelisting)
CLIENT_URL=https://staging.nexachain.internal

# Dedicated Administrative Secret for Staging Manual Triggers
# Generate with: openssl rand -hex 24
ADMIN_SECRET_KEY=REPLACE_WITH_HIGH_ENTROPY_ADMIN_SECRET_KEY_FOR_STAGING
